---------------------------------------------------------------
-- Customer Orders: Product+Design Combinations with Quantity
---------------------------------------------------------------
SELECT
    OR.CUSTOMER_ID,
    OI.PRODUCT_ID,
    OI.DESIGN_ID,
    SUM(OI.QUANTITY) AS TOTAL_QUANTITY
FROM
    USER13.ORDERS OR
    JOIN USER13.ORDER_ITEMS OI
        ON OR.ORDER_ID = OI.ORDER_ID
GROUP BY
    OR.CUSTOMER_ID,
    OI.PRODUCT_ID,
    OI.DESIGN_ID
ORDER BY
    OR.CUSTOMER_ID,
    TOTAL_QUANTITY DESC;

---------------------------------------------------------------
-- Orders by Date: Product+Design Combinations with Quantity
---------------------------------------------------------------
SELECT
    DATE(OR.ORDER_TS) AS ORDER_DATE,
    OI.PRODUCT_ID,
    OI.DESIGN_ID,
    SUM(OI.QUANTITY) AS TOTAL_QUANTITY
FROM
    USER13.ORDERS OR
    JOIN USER13.ORDER_ITEMS OI
        ON OR.ORDER_ID = OI.ORDER_ID
GROUP BY
    DATE(OR.ORDER_TS),
    OI.PRODUCT_ID,
    OI.DESIGN_ID
ORDER BY
    ORDER_DATE DESC,
    TOTAL_QUANTITY DESC;

---------------------------------------------------------------
-- Item Level Summary: Products by Attributes with Total Qty
---------------------------------------------------------------
SELECT
    I.PRODUCT_ID,
    I.SIZE,
    I.STYLE,
    I.MATERIAL,
    I.COLOR,
    SUM(OI.QUANTITY) AS TOTAL_QUANTITY_ORDERED
FROM
    USER13.INVENTORY I
    JOIN USER13.ORDER_ITEMS OI
        ON I.PRODUCT_ID = OI.PRODUCT_ID
GROUP BY
    I.PRODUCT_ID,
    I.SIZE,
    I.STYLE,
    I.MATERIAL,
    I.COLOR
ORDER BY
    TOTAL_QUANTITY_ORDERED DESC;

COMMIT;
